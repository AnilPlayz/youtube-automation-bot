# 1. Google Gemini AI API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. YouTube Data API v3 OAuth Credentials (Required for automated publishing)
# Run 'python src/setup_oauth.py' to generate these easily
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_oauth_refresh_token

# Optional overrides:
MINECRAFT_USERNAME=Anil_playz29
